# URL canónica del sitio en producción (sin slash final).
# En Vercel: Project Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://zakumistudio.com

# ---- Panel de admin (/admin) -------------------------------------------------
# Supabase: Project Settings → API. La anon key es pública por diseño;
# la protegen RLS + el signup desactivado.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Places API (New) — SOLO SERVIDOR. Jamás con prefijo NEXT_PUBLIC.
# Key restringida por API a "Places API (New)".
GOOGLE_PLACES_API_KEY=

# Google Maps JavaScript API — key de browser, restringida por referrer
# (https://zakumistudio.com/* y http://localhost:3000/*) y por API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID (Google Cloud → Map Management, tipo JavaScript). Requisito de los
# pins (AdvancedMarker) y del estilo oscuro del mapa.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# URL canónica del sitio en producción (sin slash final).
# En Vercel: Project Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://zakumistudio.com

# ---- Panel de admin (/admin) -------------------------------------------------
# Supabase: Project Settings → API. La anon key es pública por diseño;
# la protegen RLS + el signup desactivado.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Places API (New) — SOLO SERVIDOR. Jamás con prefijo NEXT_PUBLIC.
# Key restringida por API a "Places API (New)".
GOOGLE_PLACES_API_KEY=

# Google Maps JavaScript API — key de browser, restringida por referrer
# (https://zakumistudio.com/* y http://localhost:3000/*) y por API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID (Google Cloud → Map Management, tipo JavaScript). Requisito de los
# pins (AdvancedMarker) y del estilo oscuro del mapa.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# API admin del bot de WhatsApp (Flask en Railway) — SOLO SERVIDOR, jamás con
# prefijo NEXT_PUBLIC. El token es el ADMIN_API_TOKEN del servicio bot
# (acepta varios separados por coma para rotar sin ventana).
BOT_ADMIN_URL=https://bot-production-XXXX.up.railway.app
BOT_ADMIN_TOKEN=

# ---- Portal de clientes (/app) -------------------------------------------------
# Avisos por WhatsApp cuando entra una solicitud (de la tienda, de una llamada
# o del bot): se envían con el bot ya desplegado. AVISOS_WHATSAPP_TO acepta
# VARIOS números separados por comas, formato 57XXXXXXXXXX.
# Si faltan, todo funciona igual — solo se pierde el aviso.
AVISOS_BOT_INSTANCIA_ID=1
AVISOS_WHATSAPP_TO=

# ---- Agentes de voz (ElevenLabs) — /admin/voz ------------------------------------
# TODAS solo servidor, jamás con prefijo NEXT_PUBLIC. Runbook de encendido:
# docs/superpowers/specs/2026-08-22-agentes-voz-elevenlabs-design.md
# Key PROPIA de Zakumi (scope ElevenAgents). Sin ella la consola muestra
# "sin configurar" y no se puede crear/sincronizar agentes.
ELEVENLABS_API_KEY=
# Secret del webhook post-call de ZAKUMI (formato wsec_, lo genera ElevenLabs
# al crear el webhook en el dashboard). Sin él, /api/voz/webhook responde 503.
ELEVENLABS_WEBHOOK_SECRET=
# Número saliente compartido (importado de Twilio). Es el INTERRUPTOR del
# piloto: sin él se configuran agentes y funciona el widget, pero no se llama.
ELEVENLABS_PHONE_NUMBER_ID=
# Service-role de Supabase — SOLO la usan /api/voz/webhook (RPC
# registrar_llamada_voz) y /api/zak/llamar. El resto de la app sigue en anon+RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Token compartido con el bot de WhatsApp (Railway) para que Zak dispare
# llamadas vía POST /api/zak/llamar. Mismo valor en ambos lados
# (openssl rand -hex 32). Sin él, el endpoint responde 503.
ZAK_VOZ_TOKEN=

# ---- Telefonía (Twilio) — /admin/voz → Telefonía --------------------------------
# Con estas credenciales se COMPRAN números (cuesta dinero real): SOLO servidor.
# Sin ellas el panel sigue funcionando: se ven los números ya importados y el
# widget del navegador anda; solo no se puede comprar ni importar.
TWILIO_ACCOUNT_SID=
# Autenticación: se prefiere la API key (revocable sola, sin tumbar el resto de
# la cuenta). Si no está, cae al auth token de la cuenta.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=

# ---- Agenda (Google Calendar + Meet) — /admin/agenda ----------------------------
# TODAS solo servidor. OAuth con la cuenta de Tomás: las cuentas son personales
# (gmail.com) y una service account no puede escribir ahí sin Workspace.
# ⚠️ La pantalla de consentimiento debe quedar PUBLICADA EN PRODUCCIÓN: en
# modo "Testing" Google caduca el refresh token a los 7 días.
# El refresh token se saca UNA vez con: node scripts/google-oauth.mjs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# A quién se invita a cada cita (separados por comas).
AGENDA_INVITADOS=
# Duración por defecto de una cita, en minutos.
AGENDA_DURACION_MIN=30

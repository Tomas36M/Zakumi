# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# la plantilla sin secretos SÍ se versiona: documenta qué variables existen
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent / editor
.claude/
.cursor/

# Visual brainstorm companion
.superpowers/
.gstack/

# Image masters — multi-MB sources, kept outside git. Back these up yourself.
# scripts/optimize-images.mjs reads from here and writes to public/work.
/assets/masters/*
!/assets/masters/README.md
/cursos/img/originales/

# PDFs del curso: son derivados. El markdown es la fuente y
# cursos/curso-ia/pdf/build-pdf.mjs los regenera.
/cursos/Curso-Introduccion-IA-Zakumi-Academy.pdf
/cursos/curso-ia/pdf/*.pdf

# Marketing (marketing/): guiones y prompts en texto sí se versionan;
# el material pesado (renders, video, audio, fuentes) queda fuera de git.
/marketing/**/*.png
/marketing/**/*.jpg
/marketing/**/*.mp4
/marketing/**/*.mp3
/marketing/**/*.m4a
/marketing/**/*.ttf

# Documentos legales/administrativos con datos personales (cámara de comercio,
# etc.) — nunca al repo público.
/docs/empresa/

# Finanzas internas (costos, márgenes, precios en estudio) — el repo es público.
/docs/finanzas/

# Temporal del CLI de Supabase.
/supabase/.temp/

# whatsapp-bot tiene su propio repo git con su propia historia. Sin esto,
# `git add .` lo metería aquí como gitlink y quedaría un submódulo roto.
/whatsapp-bot/
